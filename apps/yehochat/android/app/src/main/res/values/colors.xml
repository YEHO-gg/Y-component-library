<?xml version="1.0" encoding="utf-8"?>
<!--
  YehoChat 色板（浅色）——与 YehoTools 保持同一套 token，视觉上对得上。

  对比度约定（重点）：
    · 浅色底 (#F5F7FA / #FFFFFF / #ADD8E6) 上一律用 text_body #22303C 作正文，
      绝不用白色或浅灰字，避免"浅字配浅底"。
    · 对方气泡是白底，靠 line_soft #E0E6EA 描边与页面底 #F5F7FA 区分开。
    · text_sub #888888 / text_muted #999999 只用于非关键的弱化文字。
-->
<resources>
    <!-- ============ 设计 token（唯一来源，业务代码不许再写死色值） ============ -->
    <!-- 背景 -->
    <color name="bg_page">#F5F7FA</color>
    <!-- 卡片 / 面板 / 顶栏 / 输入栏 -->
    <color name="bg_card">#FFFFFF</color>
    <!-- 点击态（浅灰底） -->
    <color name="bg_pressed">#EEF1F5</color>

    <!-- 文字 -->
    <color name="text_body">#22303C</color>
    <!-- 主色：标题、可点文字 -->
    <color name="text_primary">#3E7A8C</color>
    <color name="text_sub">#888888</color>
    <color name="text_muted">#999999</color>
    <color name="text_hint">#8098A0</color>
    <color name="text_on_accent">#FFFFFF</color>

    <!-- 分隔线 -->
    <color name="line">#EADFC8</color>
    <color name="line_soft">#E0E6EA</color>

    <!-- 气泡 -->
    <!-- 自己发出的气泡（浅蓝）—— 配 text_body 深色字 -->
    <color name="bubble_mine">#ADD8E6</color>
    <!-- 对方气泡（白）—— 配 line_soft 描边 -->
    <color name="bubble_other">#FFFFFF</color>
    <!-- 点引用跳转时目标气泡闪一下的高亮层（琥珀，约 36% 不透明，白底/浅蓝底上都看得清） -->
    <color name="highlight">#5CFFB300</color>
    <!-- 「回到最底部」浮层底色：主色 + 10% 透明，压在消息上仍看得清字 -->
    <color name="jump_bg">#E63E7A8C</color>

    <!-- 状态 -->
    <color name="danger">#C0392B</color>
    <color name="ok">#2E7D5B</color>
    <color name="warn">#B8860B</color>

    <!-- ============ 兼容别名（保持与旧代码同义的语义名） ============ -->
    <color name="accent">#3E7A8C</color>
    <color name="input_bg">#FFFFFF</color>
    <color name="input_line">#E0E6EA</color>
    <color name="tab_selected">#3E7A8C</color>
    <color name="tab_normal">#999999</color>
    <color name="divider">#E0E6EA</color>
</resources>
