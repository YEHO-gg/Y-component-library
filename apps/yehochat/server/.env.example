# YehoChat 服务端配置模板：复制成 .env 后填自己的值
# 读取方式是 server/yeho_env.py（零依赖解析器，启动时自动加载）；
# 已经存在的真环境变量优先，.env 不会覆盖它们。

# ---- 数据目录 ----
# 账号库、消息库、日志、证书、发号文件全部落在这一目录下
YEHOO_CHAT_DIR=./data
YEHOO_UPDATE_DIR=./update

# ---- 邮箱验证码（注册 / 找回密码）----
# 不填 SMTP 时注册接口会直接 500；只是本地试跑的话先别走注册
YEHOO_SMTP_HOST=smtp.163.com
YEHOO_SMTP_PORT=465
YEHOO_SMTP_USER=
YEHOO_SMTP_PASS=
YEHOO_SMTP_FROM=

# ---- 阿里云 OSS（更新服务下发安装包）----
# 注意：bucket 与 endpoint 目前硬编码在 update 服务代码里，
# 只有下面两个 KEY 会被读取，后两行留着是为了将来改成可配置。
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=
